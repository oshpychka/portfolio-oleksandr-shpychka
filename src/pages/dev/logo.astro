---
import Base from '../../layouts/Base.astro';
import { logoVariants } from '../../data/logo';

const full = (letters: string, tail: string) => `${letters} ${tail.replace(/^M\s*[\d.]+[\s,]+[\d.]+\s*/, '')}`;
const markBox = '0 0 175 120';
---

<Base title="Logo variants — dev" description="Temporary page to choose the OS logo." noindex>
  <section class="dev theme-dark blueprint-grid">
    <div class="container dev__inner">
      <header class="dev__head">
        <p class="mono mono-s muted">// Dev · stage 4 · temporary page</p>
        <h1>Logo: pick one</h1>
        <p class="dev__lead">
          Each mark is one continuous stroke. The line draws the O, runs along the baseline into the S and leaves to the right, then turns down. On the site that last part keeps going as the trace through every section. Drag the slider to see the letters unravel into the thread.
        </p>
      </header>

      <ol role="list" class="variants">
        {logoVariants.map((v) => (
          <li class="variant" data-variant={v.id}>
            <div class="variant__top mono">
              <span>Variant {v.id.toUpperCase()}</span>
              <span class="muted">{v.name}</span>
            </div>
            <div class="variant__stage marks">
              <svg viewBox={v.viewBox} fill="none" aria-hidden="true">
                <path d={v.letters} visibility="hidden" data-letters />
                <path class="trace" d={full(v.letters, v.tail)} data-full />
              </svg>
            </div>
            <label class="variant__slider mono mono-s">
              <span>Unravel</span>
              <input type="range" min="0" max="1000" value="0" data-unravel />
            </label>
            <button class="btn" type="button" data-replay>Replay draw</button>
            <p class="muted">{v.note}</p>
            <div class="sizes">
              <div class="size size--dark">
                <svg viewBox={markBox} width="66" height="45" fill="none" aria-hidden="true"><path d={v.letters} stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="mono mono-s muted">Header</span>
              </div>
              <div class="size size--cream">
                <svg viewBox={markBox} width="66" height="45" fill="none" aria-hidden="true"><path d={v.letters} stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="mono mono-s muted">On cream</span>
              </div>
              <div class="size size--dark">
                <svg viewBox="-12 -38 199 199" width="32" height="32" fill="none" aria-hidden="true"><path d={v.letters} stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="mono mono-s muted">Favicon 32px</span>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .dev__inner {
    display: grid;
    gap: 64px;
    padding-top: 140px;
    padding-bottom: 96px;
  }

  .dev__head {
    display: grid;
    gap: 20px;
    max-width: 70ch;
  }

  .dev__lead {
    color: var(--muted);
  }

  .variants {
    display: grid;
    gap: 48px;
  }

  .variant {
    display: grid;
    gap: 20px;
    align-content: start;
    justify-items: start;
  }

  .variant__top {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .variant__stage {
    width: 100%;
    padding: 24px;
    border: 1px solid var(--rule);
    background: rgba(0, 0, 0, 0.6);
  }

  .variant__stage svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .trace {
    stroke: var(--c-cream);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .variant__slider {
    display: grid;
    gap: 8px;
    width: 100%;
  }

  .variant__slider input {
    width: 100%;
    accent-color: var(--c-blue);
  }

  .sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .size {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--rule);
  }

  .size--dark {
    background: var(--c-black);
    color: var(--c-cream);
  }

  .size--cream {
    background: var(--c-cream);
    color: var(--c-ink);
  }

  .size--cream .muted {
    color: var(--c-muted-light);
  }

  @media (min-width: 1024px) {
    .variants {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin);

  document.querySelectorAll<HTMLElement>('[data-variant]').forEach((variant) => {
    const path = variant.querySelector<SVGPathElement>('[data-full]');
    const range = variant.querySelector<HTMLInputElement>('[data-unravel]');
    const replay = variant.querySelector<HTMLButtonElement>('[data-replay]');
    if (!path || !range || !replay) return;

    const lettersPath = variant.querySelector<SVGPathElement>('[data-letters]');
    const total = path.getTotalLength();
    const visible = lettersPath ? lettersPath.getTotalLength() : total * 0.7;

    const setUnravel = (t: number) => {
      const start = t * (total - visible);
      gsap.set(path, { drawSVG: `${start} ${start + visible}` });
    };

    const draw = () => {
      range.value = '0';
      gsap.fromTo(path, { drawSVG: '0 0' }, { drawSVG: `0 ${visible}`, duration: 2.2, ease: 'power2.inOut' });
    };

    range.addEventListener('input', () => setUnravel(Number(range.value) / 1000));
    replay.addEventListener('click', draw);
    draw();
  });
</script>
