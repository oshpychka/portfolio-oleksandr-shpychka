---
import Curve from './Curve.astro';
import { hero } from '../data/content';
import { SITE } from '../config/site';
import { cvAvailable } from '../lib/cv';
import { logo, LOGO_BOX } from '../data/logo';
import { Image, getImage } from 'astro:assets';
import sceneStill from '../assets/hero/scene.png';

const stillMobile = await getImage({ src: sceneStill, widths: [360, 540, 720], sizes: '100vw', format: 'webp' });
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

<section class="hero theme-dark blueprint-grid" aria-labelledby="hero-title" data-line-hero>
  <div class="hero__scene" data-hero-scene aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__sys mono mono-s muted" aria-hidden="true">
      <span data-scramble>// OS v{SITE.version}</span>
      <span data-scramble>Status: {SITE.status === 'available' ? 'Available' : 'Busy'}</span>
      <span hidden data-clock-wrap>Sys.time <span data-clock></span> {SITE.city}</span>
    </div>

    <div class="hero__logo" data-logo-anchor aria-hidden="true">
      <svg viewBox={`${LOGO_BOX.x} ${LOGO_BOX.y} ${LOGO_BOX.width} ${LOGO_BOX.height}`} fill="none" overflow="visible">
        <path d={logo.letters} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>
      <p class="hero__logo-note mono mono-s" data-logo-note>Scroll to unravel ↓</p>
    </div>

    <div class="hero__stage" data-scene-area aria-hidden="true">
      <picture class="hero__still hero__still--m">
        <source media="(min-width: 861px)" srcset={blank} />
        <img src={stillMobile.src} srcset={stillMobile.srcSet.attribute} sizes="100vw" alt="" width={stillMobile.attributes.width} height={stillMobile.attributes.height} loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <Image class="hero__still hero__still--d" src={sceneStill} alt="" widths={[640, 900, 1178]} sizes="42vw" loading="lazy" decoding="async" />
    </div>

    <h1 class="hero__title" id="hero-title">{SITE.firstName}<br /> Shpychka</h1>

    <div class="hero__body">
      <p class="hero__line">{hero.line}</p>
      <ul role="list" class="hero__facts mono">
        {hero.facts.map((fact) => <li>{fact}</li>)}
      </ul>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Start a project</a>
        {cvAvailable && <a class="btn" href={SITE.cv} download>Download CV</a>}
      </div>
    </div>

    <div class="hero__foot mark-row mono mono-s" aria-hidden="true">
      <span class="plus"></span>
      <span class="plus hide-s"></span>
      <span data-scramble>Scroll to explore</span>
      <span class="plus hide-s"></span>
      <span class="plus"></span>
    </div>
  </div>
  <Curve />
</section>

<style>
  .hero {
    position: relative;
  }

  .hero__inner {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: clamp(32px, 5vw, 56px);
    min-height: 100svh;
    padding-top: 120px;
    padding-bottom: 32px;
  }

  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__scene :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__stage {
    position: absolute;
    top: 42%;
    right: var(--gutter);
    width: 38%;
    height: 34%;
    pointer-events: none;
  }

  .hero__stage :global(.hero__still) {
    display: none;
    position: absolute;
    left: -12%;
    top: -30%;
    width: 124%;
    height: 160%;
    max-width: none;
    object-fit: contain;
  }

  .hero__stage :global(.hero__still img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 861px) {
    :global(.no-js) .hero__stage :global(.hero__still--d),
    :global(.scene-static) .hero__stage :global(.hero__still--d) {
      display: block;
    }
  }

  @media (max-width: 860px) {
    .hero__stage :global(.hero__still--m) {
      display: block;
    }
  }

  .hero__logo {
    position: absolute;
    top: clamp(132px, 15vh, 180px);
    right: calc(var(--gutter) + clamp(36px, 5vw, 88px));
    width: clamp(150px, 29vw, 480px);
    aspect-ratio: 182 / 80;
    color: var(--c-cream);
  }

  .hero__logo svg {
    width: 100%;
    height: 100%;
  }

  .hero__logo-note {
    position: absolute;
    top: calc(100% + 18px);
    right: 0;
    color: var(--c-cream);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.4s linear;
  }

  :global(.has-line:not(.scrolled)) .hero__logo-note {
    opacity: 0.75;
  }

  :global(.has-line) .hero__logo svg,
  :global(.is-booting) .hero__logo svg {
    visibility: hidden;
  }

  .hero__sys {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  .hero__title {
    align-self: end;
    font-size: var(--fs-display);
    line-height: 0.86;
    letter-spacing: -0.055em;
    margin-left: -0.05em;
  }

  .hero__body {
    display: grid;
    gap: 28px;
    max-width: 880px;
  }

  .hero__line {
    font-size: var(--fs-lead);
    line-height: 1.35;
    max-width: 40ch;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    color: var(--muted);
  }

  .hero__facts li:not(:last-child)::after {
    content: '+';
    margin-inline: 16px;
    color: var(--fg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__foot {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .hero__logo {
      top: 168px;
      right: calc(var(--gutter) + 28px);
      width: 36vw;
    }

    .hero__inner {
      grid-template-rows: auto minmax(200px, 1fr) auto auto auto;
    }

    .hero__stage {
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
      min-height: 170px;
      margin-top: 64px;
    }

    .hide-s {
      display: none;
    }

    .hero__facts {
      display: grid;
      gap: 6px;
    }

    .hero__facts li::before {
      content: '+';
      margin-right: 12px;
      color: var(--fg);
    }

    .hero__facts li:not(:last-child)::after {
      content: none;
    }
  }

  @media (min-width: 1024px) {
    .hero__body {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      max-width: none;
      column-gap: 64px;
    }

    .hero__line {
      grid-row: span 2;
    }
  }
</style>
