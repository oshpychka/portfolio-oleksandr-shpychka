---
interface Props {
  index: number;
  label: string;
}
const { index, label } = Astro.props;
---

<div class="section-head mono" aria-hidden="true" data-node-head>
  <span data-scramble="node">{String(index).padStart(2, '0')}</span>
  <span class="section-head__rule"></span>
  <span data-scramble="node">{label}</span>
</div>

<style>
  .section-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    color: var(--muted);
  }

  .section-head__rule {
    height: 1px;
    background: var(--rule);
  }

  @media (min-width: 1024px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 12px;
      align-content: start;
    }
  }
</style>
