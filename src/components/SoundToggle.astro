---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button class:list={['sound-toggle', className]} type="button" aria-pressed="false" data-sound-toggle hidden>
  <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="mono">Sound</span>
  <span class="mono sound-toggle__state" aria-hidden="true" data-sound-state>Off</span>
</button>

<style>
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 6px;
    color: inherit;
  }

  .sound-toggle[hidden] {
    display: none;
  }

  .sound-toggle__state {
    opacity: 0.55;
    min-width: 3ch;
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    width: 16px;
    height: 12px;
  }

  .eq i {
    flex: 1;
    height: 100%;
    background: currentColor;
    transform-origin: 50% 100%;
    transform: scaleY(0.2);
  }

  :global(.sound-on) .eq i {
    animation: eq 0.9s ease-in-out infinite alternate;
  }

  :global(.sound-on) .eq i:nth-child(2) {
    animation-duration: 0.7s;
    animation-delay: -0.3s;
  }

  :global(.sound-on) .eq i:nth-child(3) {
    animation-duration: 1.1s;
    animation-delay: -0.5s;
  }

  :global(.sound-on) .eq i:nth-child(4) {
    animation-duration: 0.8s;
    animation-delay: -0.2s;
  }

  @keyframes eq {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.sound-on) .eq i {
      animation: none;
      transform: scaleY(0.7);
    }
  }
</style>
