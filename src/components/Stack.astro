---
import SectionHead from './SectionHead.astro';
import Curve from './Curve.astro';
import { stack } from '../data/content';
---

<section class="section stack theme-cream blueprint-grid" id="stack" aria-labelledby="stack-title">
  <div class="container section-grid">
    <SectionHead index={3} label="Stack" />
    <div class="stack__content">
      <div class="stack__head">
        <h2 class="section-title" id="stack-title" data-reveal="lines">Stack</h2>
        <p class="stack__hint mono mono-s muted" data-physics-hint hidden>
          <span class="stack__hint-fine">Grab a word. Throw it.</span>
          <span class="stack__hint-touch">Tap and drag</span>
        </p>
      </div>
      <ul role="list" class="stack__words" data-physics-area>
        {stack.map((skill, i) => (
          <li class:list={['stack__word', skill.core ? 'stack__word--core' : i % 3 === 1 ? 'stack__word--ink' : null]} data-physics-body>{skill.name}</li>
        ))}
      </ul>
    </div>
  </div>
  <Curve />
</section>

<style>
  .stack__content {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }

  .stack__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  .stack__hint[hidden] {
    display: none;
  }

  .stack__hint-touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .stack__hint-fine {
      display: none;
    }

    .stack__hint-touch {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stack__words {
      position: relative;
      height: clamp(380px, 56vh, 560px);
      align-content: flex-start;
      border-bottom: 1px solid var(--rule);
    }
  }

  .stack__words.is-physics {
    user-select: none;
    -webkit-user-select: none;
  }

  .stack__words.is-physics .stack__word {
    cursor: grab;
    user-select: none;
  }

  .stack__words.is-grabbing,
  .stack__words.is-grabbing .stack__word {
    cursor: grabbing;
  }

  .stack__words {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(8px, 1.2vw, 16px);
  }

  .stack__word {
    display: inline-flex;
    align-items: center;
    min-height: 1.9em;
    padding: 0 0.7em;
    border: 1px solid var(--fg);
    border-radius: var(--radius-pill);
    background: var(--bg);
    font-size: clamp(1.25rem, 0.9rem + 2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1;
    white-space: nowrap;
  }

  .stack__word--ink {
    background: var(--fg);
    color: var(--bg);
  }

  .stack__word--core {
    font-size: clamp(1.6rem, 1.1rem + 2.8vw, 3.75rem);
    border-color: var(--c-blue);
    background: var(--c-blue);
    color: var(--c-ink);
  }
</style>
