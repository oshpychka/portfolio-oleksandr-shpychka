---
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<svg class:list={['logo-mark', className]} width={size} height={size * 0.6} viewBox="0 0 50 30" fill="none" aria-hidden="true">
  <circle cx="13" cy="15" r="10" stroke="currentColor" stroke-width="2.4" />
  <path
    d="M45 8.6C43.8 6.3 41.6 5 39 5c-3.4 0-6 2-6 4.9 0 6.6 12.2 4.1 12.2 11.1 0 3.2-2.8 5-6.4 5-2.9 0-5.2-1.3-6.4-3.8"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
  />
</svg>
