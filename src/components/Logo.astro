---
import { logoMark } from '../data/logo';

interface Props {
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { size = 48, strokeWidth = 1.6, class: className } = Astro.props;
const [, , w, h] = logoMark.viewBox.split(' ').map(Number);
---

<svg class:list={['logo-mark', className]} width={size} height={Math.round((size * h) / w)} viewBox={logoMark.viewBox} fill="none" aria-hidden="true">
  <path d={logoMark.d} stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
</svg>
