---
import { contact } from '../data/content';
import { SITE } from '../config/site';
import { logo, LOGO_BOX } from '../data/logo';

interface Props {
  cta?: boolean;
  mark?: boolean;
}
const { cta = false, mark = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {cta && (
    <div class="site-footer__cta">
      <p class="mono muted">Have a project?</p>
      <a class="site-footer__mail" href="/#contact">Let's talk →</a>
    </div>
  )}
  {mark && (
    <div class="site-footer__mark" data-logo-end aria-hidden="true">
      <svg viewBox={`${LOGO_BOX.x} ${LOGO_BOX.y} ${LOGO_BOX.width} ${LOGO_BOX.height}`} fill="none" overflow="visible">
        <path d={logo.letters} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  )}
  <div class="site-footer__bar mono mono-s">
    <p>{contact.footer}</p>
    <p class="muted">© {year} {SITE.name}</p>
    <button class="site-footer__bp mono mono-s" type="button" aria-pressed="false" data-blueprint-toggle hidden>Blueprint mode</button>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    gap: clamp(48px, 8vw, 96px);
  }

  .site-footer__cta {
    display: grid;
    gap: 12px;
  }

  .site-footer__mail {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    justify-self: start;
  }

  .site-footer__mail:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .site-footer__mark {
    justify-self: end;
    width: clamp(150px, 29vw, 480px);
    aspect-ratio: 182 / 80;
    margin-right: clamp(36px, 5vw, 88px);
  }

  .site-footer__mark svg {
    width: 100%;
    height: 100%;
  }

  :global(.has-line) .site-footer__mark svg {
    visibility: hidden;
  }

  @media (max-width: 860px) {
    .site-footer__mark {
      width: 36vw;
      margin-right: 28px;
    }
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .site-footer__bar a {
    padding: 4px 0;
  }

  .site-footer__bp {
    padding: 4px 0;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .site-footer__bp[hidden] {
    display: none;
  }

  .site-footer__bp[aria-pressed='true'] {
    color: var(--accent);
  }
</style>
