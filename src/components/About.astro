---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Curve from './Curve.astro';
import { about } from '../data/content';
import photo from '../assets/about/developer.jpg';
---

<section class="section about theme-cream blueprint-grid" id="about" aria-labelledby="about-title">
  <div class="container section-grid">
    <SectionHead index={1} label="About" />
    <div class="about__content">
      <h2 class="about__title" id="about-title" data-reveal="lines">{about.heading}</h2>
      <div class="about__cols">
        <figure class="about__photo marks">
          <div class="frame" data-parallax="8">
            <Image src={photo} alt={about.photoAlt} widths={[360, 540, 720, 960]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" loading="lazy" />
          </div>
        </figure>
        <div class="about__text">
          {about.paragraphs.map((p) => <p>{p}</p>)}
          <ul role="list" class="about__points">
            {about.points.map((point) => (
              <li>
                <span class="mono mono-s">{point.label}</span>
                <span>{point.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
  <Curve />
</section>

<style>
  .about__content {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
  }

  .about__title {
    max-width: 16ch;
  }

  .about__cols {
    display: grid;
    gap: 40px;
  }

  .about__photo {
    max-width: 420px;
  }

  .frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--c-indigo);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__text {
    display: grid;
    gap: 20px;
    align-content: start;
    max-width: 60ch;
  }

  .about__text > p:first-child {
    font-size: var(--fs-lead);
    line-height: 1.4;
  }

  .about__points {
    display: grid;
    margin-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .about__points li {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .about__points .mono {
    color: var(--accent);
  }

  @media (min-width: 640px) {
    .about__cols {
      grid-template-columns: minmax(220px, 5fr) 7fr;
      gap: clamp(32px, 5vw, 80px);
    }

    .about__points li {
      grid-template-columns: 140px 1fr;
      gap: 24px;
    }
  }
</style>
